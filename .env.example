NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Runtime uses the pooled 6543 URL with pgbouncer=true&schema=astreus (the pooler's
# transaction mode needs pgbouncer=true to avoid prepared-statement errors). For
# `npm run db:push` use the direct 5432 URL with schema=astreus only (no pgbouncer
# param) — the pooler doesn't support the DDL session db push needs; scripts/db-push.mjs
# derives this automatically, you don't need a second variable.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres?schema=astreus&pgbouncer=true
