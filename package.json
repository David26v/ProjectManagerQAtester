{
  "name": "qa-flow",
  "version": "2.0.1",
  "description": "Astreus Tech Tester Tool — record, run, and report browser QA suites",
  "author": "Astreus Tech",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/**/*.test.js",
    "smoke": "npm run build:renderer && electron . --smoke",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "release": "npm run build:renderer && electron-builder --win --publish always",
    "db:push": "node scripts/db-push.mjs"
  },
  "build": {
    "appId": "com.astreus.testertool",
    "productName": "Astreus Tech Tester Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "src/engine/**",
      "src/renderer/dist/**",
      "bin/**",
      "package.json",
      "node_modules/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "David26v",
        "repo": "ProjectManagerQAtester",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.4",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "isomorphic-git": "^1.41.9",
    "lucide-react": "^1.34.0",
    "playwright": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "adm-zip": "^0.6.0",
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
